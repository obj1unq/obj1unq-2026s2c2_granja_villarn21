import granja.*
import wollok.game.*
import personaje.*
import cultivos.*
import mercado.*


program lagranja {
	//  CONFIG	
	game.title("La granja")
	game.height(10)
	game.width(10)
	game.ground("fondo.png")
	//
	game.addVisual(mercado)     
 	game.addVisualCharacter(personaje)
	//keys
	keyboard.g().onPressDo{personaje.cambiarGenero()}
	keyboard.m().onPressDo({personaje.plantar(new Maiz(position = personaje.position()))})
	keyboard.t().onPressDo({personaje.plantar(new Trigo(position = personaje.position()))})
	keyboard.o().onPressDo({personaje.plantar(new Tomaco(position = personaje.position()))})
	keyboard.r().onPressDo({granja.regar()})
	keyboard.c().onPressDo({granja.cosechar()})
	keyboard.space().onPressDo({personaje.cosechaAVender()})
 	//  COMIENZA
	game.onCollideDo(personaje, {mercado=> mercado.interactuar(personaje)})
	game.start()
}
